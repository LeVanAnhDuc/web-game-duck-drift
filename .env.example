# Biến môi trường — BẢN MẪU. Copy thành `.env` rồi điền giá trị thật.
#
#   cp .env.example .env
#
# Trả lời câu hỏi: cần biến nào để chạy được dự án này?
# Trạng thái:     🟢 đủ — sáu biến NEXT_PUBLIC_*, đều tuỳ chọn khi chạy ở máy
# Cập nhật khi:    code đọc một biến mới (process.env.X / os.getenv / os.Getenv / ...)
#
# HAI QUY TẮC
#   1. File này KHÔNG chứa giá trị thật. Chỉ tên biến + cách lấy giá trị.
#      `.env` là bản thật và đã bị .gitignore — giữ nguyên như vậy.
#   2. Danh sách này phải khớp CODE, không khớp tài liệu thiết kế. Biến nào code
#      không còn đọc thì xoá; biến nào code đọc mà thiếu ở đây là một cái bẫy.

# Mọi biến NEXT_PUBLIC_* đều CÔNG KHAI — Next inline chúng vào bundle lúc build.
# Đừng bao giờ đặt bí mật ở đây.

# ─────────────────────────────────────────────────────────────
# Đường dẫn gốc
# ─────────────────────────────────────────────────────────────

# đọc bởi:      next.config.ts, src/auth/config.ts (dựng redirect_uri)
# bắt buộc khi: build để deploy lên GitHub Pages (đường dẫn con /web-game-duck-drift)
# lấy ở đâu:    workflow .github/workflows/deploy.yml tự đặt "/web-game-duck-drift".
#               Ở máy thì để trống: `pnpm dev` và `pnpm build` chạy ở gốc.
NEXT_PUBLIC_BASE_PATH=

# ─────────────────────────────────────────────────────────────
# Đăng nhập Ducker ID (OIDC Authorization Code + PKCE) — TUỲ CHỌN, đang tắt
# ─────────────────────────────────────────────────────────────
# Game là public client (không backend) nên KHÔNG có client_secret. Tính năng chỉ
# bật khi cờ = "true" VÀ đủ cả bốn giá trị bên dưới; thiếu một là tắt hẳn, game chạy
# như cũ. Không có giá trị mặc định nào trong code.
#
# deploy.yml KHÔNG truyền cờ này nên bản trên GitHub Pages không có nút đăng nhập
# (ADR-0021). Chỉ chạy thử ở máy.
#
# Đăng ký ở admin console của Ducker ID, redirect URI phải khớp TUYỆT ĐỐI:
#   local:  http://localhost:4311/        (pnpm dev -p 4311 hoặc serve bản export)
#   prod:   https://levananhduc.github.io/web-game-duck-drift/
# Và thêm origin (http://localhost:4311) vào CORS_ORIGINS của server Ducker ID,
# vì trình duyệt gọi thẳng /oauth/token và /oauth/userinfo.

# đọc bởi:      src/auth/config.ts
# lấy ở đâu:    chỉ đúng chuỗi "true" mới bật.
NEXT_PUBLIC_FEATURE_DUCKER_SIGN_IN=true
# Gốc của Ducker ID (nơi có /oauth/authorize, /oauth/token, /oauth/userinfo).
NEXT_PUBLIC_DUCKER_ISSUER=http://localhost:3000
# client_id của game này, đã đăng ký trong admin console của Ducker ID.
NEXT_PUBLIC_DUCKER_CLIENT_ID=
# Scope xin khi đăng nhập — phải nằm trong allowed scopes của client.
NEXT_PUBLIC_DUCKER_SCOPE=openid profile email
# Trang hồ sơ trên Ducker ID mà menu tài khoản liên kết tới (tương đối với ISSUER).
NEXT_PUBLIC_DUCKER_PROFILE_PATH=/profile

# ─────────────────────────────────────────────────────────────
# Tuỳ chọn — có mặc định trong code
# ─────────────────────────────────────────────────────────────

# đọc bởi:      scripts/check-bundle-size.mjs
# bắt buộc khi: không bao giờ — mặc định 200, đúng ngưỡng NFR-PERF-04
# lấy ở đâu:    tự đặt, chỉ để thử tạm một ngưỡng khác khi đang điều tra bundle.
#               Muốn ĐỔI ngưỡng thật thì sửa nfr.md trước, đừng sửa biến này.
# BUNDLE_LIMIT_KB=200

# đọc bởi:      next.config.ts
# bắt buộc khi: không bao giờ — chỉ scripts/build-e2e-auth.mjs đặt "true" để export bản
#               bật đăng nhập (issuer giả) ra out-auth/ cho e2e. Đừng đặt tay.
# E2E_AUTH_BUILD=
