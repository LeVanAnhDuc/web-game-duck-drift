#!/usr/bin/env bash
# Git hook: chạy ESLint trên các file ĐANG STAGED trước khi commit.
#
# Bật cùng cơ chế với commit-msg:
#
#     git config core.hooksPath .githooks
#
# Vì sao không dùng husky + lint-staged như dự án quapp (R-22): husky ghi đè đúng
# `core.hooksPath` mà hook commit-msg đang dựa vào, nên cài husky vào đây sẽ làm
# commit-lint IM LẶNG ngừng chạy. Một cơ chế hook, không phải hai.
#
# Vì sao không `--fix`: hook sửa file đang staged sẽ commit một nội dung khác với
# nội dung người viết vừa đọc lại. Ở đây chỉ BÁO, người sửa.
#
# Đây là phản hồi nhanh, KHÔNG phải rào chắn: `core.hooksPath` không theo được
# `git clone`, và `--no-verify` bỏ qua được. Rào chắn thật là .github/workflows/ci.yml.
set -uo pipefail

root="$(git rev-parse --show-toplevel)"

# Chỉ file còn tồn tại (A/C/M/R) — file vừa xoá thì không có gì để lint.
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx')

if [ "${#staged[@]}" -eq 0 ]; then
  exit 0
fi

cd "$root" || exit 1

if ! pnpm exec eslint --max-warnings=0 "${staged[@]}"; then
  printf '\n  Commit bị chặn: ESLint báo lỗi ở file đang staged.\n' >&2
  printf '  Sửa tự động được phần lớn : pnpm exec eslint --fix %s\n' "${staged[*]}" >&2
  printf '  Bỏ qua có chủ đích (hiếm) : git commit --no-verify\n\n' >&2
  exit 1
fi
