{
  "name": "web-game-duck-drift-automation-testing",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "test": "playwright test --project=app*",
    "test:smoke": "playwright test --project=app* --grep @smoke",
    "test:full": "cross-env FULL=1 playwright test --project=app*",
    "test:unit": "playwright test --project=unit",
    "provision": "playwright test --project=provision",
    "coverage:check": "node --experimental-strip-types --no-warnings scripts/coverage-check.ts",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^26.6.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.3"
  }
}
